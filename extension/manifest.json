{
  "manifest_version": 3,
  "name": "Bid Tracker",
  "version": "1.3.0",
  "description": "Press Ctrl+. on any website to save its page details to your database.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bid Tracker",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}