PORT=4000
MONGODB_URI=mongodb://localhost:27017/bid_tracker
# Long random string; paste the same value into the extension Options page and the web app Settings.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=change-me

# Optional hosted OpenAI-compatible chat-completions API enrichment.
AI_ENABLED=false
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=20000
